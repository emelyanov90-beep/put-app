[Unit]
Description=Vput PocketBase backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vput
Group=vput
WorkingDirectory=/opt/vput
EnvironmentFile=/etc/vput/pocketbase.env
Environment=GOMEMLIMIT=512MiB
ExecStart=/opt/vput/pocketbase serve --http=127.0.0.1:8090 --dir=/var/lib/vput/pb_data --hooksDir=/opt/vput/pb_hooks --migrationsDir=/opt/vput/pb_migrations --encryptionEnv=PB_ENCRYPTION_KEY
Restart=always
RestartSec=5
LimitNOFILE=4096
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vput
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
